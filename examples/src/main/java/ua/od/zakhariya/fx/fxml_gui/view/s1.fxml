<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="paneUploadFiles" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ua.od.zakhariya.fx.fxml_gui.controller.S1Controller">
   <children>
      <Button fx:id="btnSelectFiles" layoutX="24.0" layoutY="24.0" mnemonicParsing="false" onAction="#selectFiles" text="Select files" />
      <Button fx:id="btnUploadFiles" layoutX="112.0" layoutY="24.0" mnemonicParsing="false" onAction="#uploadFiles" text="Upload" />
      <ProgressBar fx:id="progUpload" layoutX="24.0" layoutY="58.0" prefWidth="200.0" progress="0.0" />
      <Button fx:id="btnOk" layoutX="553.0" layoutY="361.0" mnemonicParsing="false" text="OK" />
   </children>
</AnchorPane>
